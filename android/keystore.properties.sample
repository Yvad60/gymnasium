# Copy to keystore.properties and fill in. storeFile is relative to android/app/.
# Generate a keystore with:
#   cd android/app && keytool -genkeypair -v -storetype PKCS12 \
#     -keystore my-release.keystore -alias my-alias \
#     -keyalg RSA -keysize 2048 -validity 10000
storeFile=my-release.keystore
storePassword=
keyAlias=my-alias
keyPassword=
